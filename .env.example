# API (FastAPI service)
DATABASE_URL=sqlite:///./data/hubmi.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@hubmi.dev
ADMIN_PASSWORD=admin12345
ADMIN_FULL_NAME=HubMI Admin

# LLM: `fake` | `openai` (platform.openai.com) | `gemini` (aistudio.google.com)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Czat (`app/routes/chat.py`) — Gemini, aistudio.google.com
GEMINI_API_KEY=

# Web BFF → API (local only; on Vercel injected via service binding as API_URL)
# Copy to apps/web/.env.local as well for `npm run dev`.
API_URL=http://localhost:8000
