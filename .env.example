# API (FastAPI service)
DATABASE_URL=sqlite:///./data/hubmi.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@malohub.dev
ADMIN_PASSWORD=admin12345
ADMIN_FULL_NAME=MaloHUB Admin
# Zwykłe konto do pokazu; pusty DEMO_USER_EMAIL wyłącza seed
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=user12345
DEMO_USER_FULL_NAME=User Example
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
SCRAPE_ON_STARTUP=true

# LLM dla czatu / kreatora (`app/routes/chat.py` → OpenAI-compatible API)
# Na Vercel ustaw na serwisie **api** (nie web).
# LLM_PROVIDER wybiera domyślny host, gdy LLM_BASE_URL jest puste:
#   openai → https://api.openai.com/v1
#   openrouter → https://openrouter.ai/api/v1
#   deepseek → https://api.deepseek.com
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Web BFF → API (local only; on Vercel injected via service binding as API_URL)
# Copy to apps/web/.env.local as well for `npm run dev`.
API_URL=http://localhost:8000
